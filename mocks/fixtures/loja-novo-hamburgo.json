  "servicos": [
    {
      "nome": "Montagem de pneus",
      "texto": "O serviço de montagem executado corretamente, garante a integridade dos pneus e rodas, evitando cortes e danificação dos talões dos pneus e danos às rodas.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/montagem-de-pneus.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Rodízio dos Pneus",
      "texto": "É a inversão de posição entre os pneus do veículo, tendo como objetivo principal prolongar a vida útil e o desgaste uniforme dos mesmos, garantindo uma maior segurança ao dirigir.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/rodizio-dos-pneus.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Balanceamento Estático e Dinâmico",
      "texto": "O balanceamento das massas equilibra os conjuntos de rodas e pneus, permitindo a eliminação de vibrações, responsáveis por desconforto na direção. Contribuindo para preservar a vida útil dos elementos da suspensão, como amortecedores, buchas, batentes e pneus.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/balanceamento-estatico-e-dinamico.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Alinhamento e balanceamento",
      "texto": "O alinhamento é o ajuste das rodas de acordo com parâmetros fornecidos pelo fabricante do veículo. Contribui para o conforto ao dirigir, garante estabilidade e segurança e evita o desgaste irregular dos pneus.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/alinhamento-e-balanceamento.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Cáster",
      "texto": "Deve ser feito sempre que fizer o alinhamento de direção e for detectado que as medidas do cáster estão em desacordo com as medidas especificadas pelo fabricante do veículo, quando a direção estiver pesada e também quando as rodas apresentarem dificuldade para voltar à posição inicial após qualquer deslocamento.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/caster.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Suspensão",
      "texto": "Componentes de suspensão danificados comprometem o conforto, a segurança e contribuem para a deterioração de outros itens do veículo, como buchas, batentes, amortecedores e pneus.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/suspensao.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Freios",
      "texto": "São itens de segurança de grande importância, verifique sempre o estado de discos, pastilhas ou lonas de freio, tambores, cilindros, pinças e o fluído de freio. Eles são responsáveis pela segurança dos ocupantes do veículo, muitas vezes ajudam a evitar acidentes e salvar vidas.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/freios.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Troca de Óleo",
      "texto": "Trocar o óleo dentro do período correto é essencial para manter o bom funcionamento do seu veículo.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/troca-de-oleo.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Substituição de Filtros",
      "texto": "Troca dos filtros de ar, filtros de combustível e filtros de óleo do amortecedor obedecendo às especificações recomendadas pelo fabricante do veículo.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/substituicao-de-filtros.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Conserto, personalização e pintura de rodas",
      "texto": "Além de proporcionar ganho estético, as rodas em perfeito estado contribuem para o conforto na direção, pois não trepidam. Ao contrário de rodas tortas que podem contribuir para o desgaste irregular dos pneus e dos componentes de suspensão.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/conserto-personalizacao-e-pintura-de-rodas.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Palhetas",
      "texto": "Contribuem para a visibilidade, principalmente em dias chuvosos. Devem ser substituídas quando estiverem ressecadas ou quando estiverem quebradiças.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/palhetas.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    },
    {
      "nome": "Outros Serviços Tercerizados",
      "texto": "Ar condicionado, forração em couro, serviços de lava car e vidros.",
      "foto": {
        "src": "/img/lojas/novo-hamburgo/outros-servicos-tercerizados.webp",
        "largura": 524,
        "altura": 348,
        "alt": ""
      }
    }
  ],
