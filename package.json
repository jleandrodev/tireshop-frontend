{
  "name": "tireshop-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cobertura": "vitest run --coverage"
  },
  "devDependencies": {
    "@nuxt/test-utils": "4.4.0",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "prettier": "3.10.1",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "nuxt": "4.7.0",
    "vue": "3.5.46",
    "vue-router": "5.5.1"
  }
}
